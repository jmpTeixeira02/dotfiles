{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "timezone": "Etc/UTC",
    "schedule": [
        "every weekend"
    ],
    "nix": {
        "enabled": true
    },
    "packageRules": [
        {
            "matchPackageNames": [
                "*"
            ],
            "groupName": "all dependencies"
        }
    ],
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/^nix\\/.*\\.nix$/"
            ],
            "matchStrings": [
                "image\\s*=\\s*\"(?<depName>[^\" ]+):(?<currentValue>[^\"@]+)@(?<currentDigest>sha256:[a-f0-9]+)\""
            ],
            "datasourceTemplate": "docker"
        }
    ]
}
