{
    "$schema": "https://opencode.ai/config.json",
    "permission": {
        "*": "ask",
        "read": {
            "*": "allow",
            "*.env": "deny",
            "*.env.*": "deny",
            "*.sops.*": "deny",
            "*secrets.zsh": "deny",
            "*.env.example": "allow"
        }
    },
    "share": "disabled",
    "plugin": [
        "@dietrichgebert/ponytail",
        "opencode-caveman"
    ]
}
