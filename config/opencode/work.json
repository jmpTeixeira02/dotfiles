{
    "$schema": "https://opencode.ai/config.json",
    "share": "disabled",
    "model": "anthropic/claude-opus-latest",
    "small_model": "anthropic/claude-sonnet-4-6",
    "disabled_providers": [
        "opencode"
    ],
    "enabled_providers": [
        "anthropic",
        "openai",
        "google"
    ],
    "provider": {
        "anthropic": {
            "name": "HAI Anthropic",
            "options": {
                "apiKey": "{env:HAI_PROXY_API_KEY}",
                "baseURL": "http://localhost:6655/anthropic/v1"
            }
        },
        "google": {
            "name": "HAI Gemini",
            "options": {
                "apiKey": "{env:HAI_PROXY_API_KEY}",
                "baseURL": "http://localhost:6655/gemini/v1beta"
            }
        },
        "openai": {
            "name": "HAI OpenAI",
            "options": {
                "apiKey": "{env:HAI_PROXY_API_KEY}",
                "baseURL": "http://localhost:6655/openai/v1"
            }
        }
    }
}
