window-rule {
    match app-id=r#"^bitwarden$"#
    match app-id=r#"^io.ente.auth$"#

    block-out-from "screencast"
}
layer-rule {
    match namespace="^noctalia-notification$"
    block-out-from "screencast"
}

binds {
    Mod+Insert { set-dynamic-cast-window; }
    Mod+Home { set-dynamic-cast-monitor; }
    Mod+Delete {clear-dynamic-cast-target;}
}
