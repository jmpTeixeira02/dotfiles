spawn-at-startup "niriusd"
spawn-at-startup "zen-beta"
spawn-at-startup "ghostty"
spawn-sh-at-startup "mangohud steam"
spawn-sh-at-startup "sleep 1 && discordptb"
spawn-at-startup "zapzap"
spawn-at-startup "spotify"
workspace "browser" {
    open-on-output "DP-1"
}
window-rule {
    match at-startup=true app-id="zen-beta"
    open-on-workspace "browser"
    open-maximized true
}
workspace "terminal" {
    open-on-output "DP-1"
}
window-rule {
    match at-startup=true app-id="com.mitchellh.ghostty"
    open-on-workspace "terminal"
    open-maximized true
}
workspace "steam" {
    open-on-output "DP-1"
}
window-rule {
    match app-id="^steam_app_\\d+$"
    open-on-workspace "steam"
}
window-rule {
    match at-startup=true app-id="steam"
    exclude title="^notificationtoasts_"
    open-on-workspace "steam"
}
window-rule {
    match at-startup=true app-id="steam" title="^Steam$"
    open-on-workspace "steam"
    open-maximized true
}
workspace "chat" {
    open-on-output "DP-2"
}
window-rule {
    match at-startup=true app-id="discord"
    match at-startup=true app-id="com.rtosta.zapzap"
    open-on-workspace "chat"
}
workspace "music" {
    open-on-output "DP-2"
}
window-rule {
    match at-startup=true app-id="spotify"
    open-on-workspace "music"
    open-maximized true
}
workspace "email" {
    open-on-output "DP-2"
}
window-rule {
    match at-startup=true app-id="thunderbird"
    open-on-workspace "email"
    open-maximized true
}
